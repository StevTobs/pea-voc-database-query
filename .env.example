# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า (ห้าม commit ไฟล์ .env)
# รหัสผ่านไม่ต้องใส่ในไฟล์นี้ โปรแกรมจะถามทุกครั้งที่รัน

# Host/Port ที่เครื่องนี้เข้าถึงได้จริง
# - ต่อผ่าน VPN ตรง: ใส่ IP/port ของ PostgreSQL
# - ต่อผ่าน SSH tunnel: ใส่ 127.0.0.1 และ local port ที่กำหนดใน ssh -L
# - อย่าใช้ port ชั่วคราวของ DBeaver (เช่น 43400) เพราะเปลี่ยนทุกครั้ง
DB_HOST=
DB_PORT=

DB_NAME=pea_voc
DB_USER=voc_user

# disable | allow | prefer | require | verify-ca | verify-full
# ถ้าผู้ดูแลระบบให้ไฟล์ CA มา แนะนำ verify-full และกรอก DB_SSLROOTCERT
DB_SSLMODE=prefer
DB_SSLROOTCERT=

DB_CONNECT_TIMEOUT_S=10
DB_STATEMENT_TIMEOUT_MS=30000
# จำนวนแถวตัวอย่าง (สูงสุด 100)
DB_SAMPLE_ROWS=100
# จำนวนเรื่อง VOC ล่าสุดสำหรับคำสั่ง v (ชุดตัวอย่างที่สัมพันธ์กัน)
# voc_tracking มีหลายแถวต่อเรื่องและจำกัดไว้ 100 แถว จึงไม่ควรตั้งสูงเกินไป
DB_RELATED_ROWS=20

# ----- สำหรับเว็บแอป (app.py) -----
# SSH tunnel ที่แอปเปิดให้เอง (ถ้าเว้น SSH_HOST ว่าง แอปจะต่อ DB_HOST/DB_PORT ตรง)
# host key ของ SSH server ต้องอยู่ใน ~/.ssh/known_hosts แล้ว (ssh เข้าเครื่องนั้นด้วยมือหนึ่งครั้ง)
SSH_HOST=
SSH_PORT=22
SSH_USER=
# ที่อยู่ PostgreSQL ตามที่ SSH server มองเห็น
SSH_REMOTE_DB_HOST=
SSH_REMOTE_DB_PORT=

# เครือข่ายที่อนุญาตให้ใช้แอป (คั่นด้วย ,) ต้องกรอกอย่างน้อยหนึ่งแบบ
# macOS มักซ่อนชื่อ Wi-Fi จึงแนะนำใช้ MAC ของ router — ดูค่าได้จาก: python netguard.py
ALLOWED_WIFI_SSIDS=
ALLOWED_GATEWAY_MACS=
