{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Data Viewer app (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app.py"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Sample export (CSV)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/sample_export.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}